# Telegram Bot API settings for new-booking notifications.
# Set these in the API process/service environment; do not commit real values.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token
TELEGRAM_CHAT_ID=-1001234567890

# Path prefix the reverse proxy mounts the API under (see deploy/apache).
# Leave empty to serve the API from the host root.
ROOT_PATH=/control-api

# CCTV camera credentials for /camera-stream.
# Set these in the API process/service environment; do not commit real values.
CAM_USER=admin
CAM_PASSWORD=replace_with_camera_password
CAM_RTSP_PORT=554
CAM_RTSP_PATH=/
